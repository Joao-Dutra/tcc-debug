# Dependências
node_modules/

# Build
dist/
dist-ssr/
*.local

# Variáveis de ambiente — nunca versionar credenciais do Supabase
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editores
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Claude Code — configuração local da máquina, não do projeto
.claude/settings.local.json

# Artefatos de teste do núcleo
instr.test.mjs
coverage/

# Artefatos do Playwright
test-results/
playwright-report/

# Análise do TCC — dados por participante nunca entram no repositório público.
# Só o código da análise (analise/*.py) é versionado.
analise/dados/
analise/saida/
analise/.venv/
analise/**/*.csv
analise/**/*.json
analise/**/*.md
!analise/README.md
# Tabelas agregadas, sem id de participante, que entram no texto do TCC (D52).
!analise/resultados/
!analise/resultados/*.csv
!analise/resultados/*.md
analise/__pycache__/
